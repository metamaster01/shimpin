{%- comment -%}
  Line icons for the Shimpin trust strip. Usage: {% render 'shimpin-trust-icon', icon: 'delivery' %}
  Draws with currentColor, so the strip colour controls them.
{%- endcomment -%}
<svg class="shp-trust__svg" aria-hidden="true" focusable="false" width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {%- case icon -%}
    {%- when 'alteration' -%}
      <path d="M30 12l-5 6v34h30V18l-5-6"/>
      <path d="M30 12l7 9 7-9"/>
      <path d="M37 21v31" stroke-dasharray="2 3"/>
      <circle cx="12" cy="40" r="4"/><circle cx="12" cy="52" r="4"/>
      <path d="M15 42l12-14M15 50l12-10"/>
    {%- when 'delivery' -%}
      <circle cx="26" cy="32" r="18"/>
      <path d="M26 20v12l7 5"/>
      <path d="M26 14v3M26 47v3M14 32h3M35 32h3"/>
      <path d="M40 32h20M54 25l7 7-7 7"/>
    {%- when 'returns' -%}
      <path d="M10 26l22-10 22 10v22L32 58 10 48z"/>
      <path d="M10 26l22 10 22-10M32 36v22"/>
      <path d="M44 8c6 0 11 4 11 10M55 18l-3-4M55 18l4-3"/>
    {%- when 'options' -%}
      <path d="M32 32c-5-6-9-9-14-9a9 9 0 000 18c5 0 9-3 14-9zm0 0c5 6 9 9 14 9a9 9 0 000-18c-5 0-9 3-14 9z"/>
      <path d="M22 14l10-6 10 6M32 8v3"/>
      <path d="M26 54h12M28 50l4-5 4 5" />
    {%- when 'shield' -%}
      <path d="M32 8l20 7v15c0 13-8 22-20 26C20 52 12 43 12 30V15z"/>
      <path d="M23 32l6 6 12-13"/>
    {%- when 'support' -%}
      <path d="M12 36v-4a20 20 0 0140 0v4"/>
      <rect x="9" y="34" width="9" height="14" rx="3"/><rect x="46" y="34" width="9" height="14" rx="3"/>
      <path d="M50 48c0 6-6 8-14 8"/>
    {%- else -%}
      <circle cx="32" cy="32" r="18"/>
  {%- endcase -%}
</svg>
