{{ 'shimpin-auth.css' | asset_url | stylesheet_tag }}

<div class="shimpin-auth">
  <div class="shimpin-auth__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1100x' }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', alt: section.settings.heading }}
    {%- endif -%}
    {%- if section.settings.caption != blank -%}
      <p class="shimpin-auth__caption" style="color: navy;">{{ section.settings.caption | escape }}</p>
    {%- endif -%}
  </div>

  <div class="shimpin-auth__panel">
    <div class="shimpin-auth__box">
      {%- if settings.logo != blank -%}
        <a href="{{ routes.root_url }}" class="shimpin-auth__logo">
          {{ settings.logo | image_url: width: 300 | image_tag: width: 150, alt: shop.name }}
        </a>
      {%- endif -%}

      {%- if customer -%}
        <h1>Hi, {{ customer.first_name | default: 'there' }}</h1>
        <a class="button button--full-width" href="{{ routes.account_url }}">My account</a>
        <a class="shimpin-auth__link" href="{{ routes.account_logout_url }}">Log out</a>
      {%- else -%}
        <h1>{{ section.settings.heading | escape }}</h1>
        <p>{{ section.settings.text | escape }}</p>
        <a class="button button--full-width" href="{{ routes.account_login_url }}">Sign in</a>
        <p class="shimpin-auth__or">New to {{ shop.name }}?</p>
        <a class="button button--secondary button--full-width" href="{{ routes.account_register_url }}">Create an account</a>
        <p class="shimpin-auth__methods">Sign in with Shop, Google or your email</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shimpin sign-in",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Left image" },
    { "type": "video", "id": "video", "label": "Left video (optional, replaces image)" },
    { "type": "text", "id": "caption", "label": "Caption on image", "default": "Style that speaks." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome to Shimpin" },
    { "type": "text", "id": "text", "label": "Text", "default": "Sign in to track orders, save favourites and check out faster." }
  ],
  "presets": [{ "name": "Shimpin sign-in" }]
}
{% endschema %}